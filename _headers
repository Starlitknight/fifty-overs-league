# Cache policy for Cloudflare Pages / Netlify (GitHub Pages ignores this file,
# which is one of the reasons we are leaving it).
#
# The PAGE is never cached: every load asks the origin, so every player is on
# the current build the moment it deploys - the "stale build served for ten
# minutes" class of bug becomes structurally impossible.
#
# The PROGRAM (assets/fo-<build>.js) is cached forever, safely: a new build
# has a new filename, so a cached copy can never be the wrong one.

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/version.json
  Cache-Control: no-cache

/client/game.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
